{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audrey-secure",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-secure",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  }
}
