{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audrey-gateway",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "audrey.eoinfarrer.uk",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "STATIC",
      "service": "audrey-secure"
    }
  ],
  "vars": {
    "AUDREY_ACCESS_TEAM_DOMAIN": "delicate-hill-df88.cloudflareaccess.com",
    "AUDREY_ACCESS_AUD": "0506e07c394075743e8495d20e0fda62acb4a830dc7c211329692dcede1ef72b"
  }
}
