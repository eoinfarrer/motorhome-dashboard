{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audrey-gateway",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-03",
  "keep_vars": true,
  "secrets": {
    "required": [
      "AUDREY_GATEWAY_SECRET"
    ]
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "audrey.eoinfarrer.uk",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "STATIC",
      "service": "audrey-secure"
    }
  ],
  "vars": {
    "AUDREY_ACCESS_TEAM_DOMAIN": "delicate-hill-df88.cloudflareaccess.com",
    "AUDREY_ACCESS_AUD": "0506e07c394075743e8495d20e0fda62acb4a830dc7c211329692dcede1ef72b",
    "AUDREY_ALLOWED_EMAIL_HASHES": "afd76a0e454d2edbc591115d0cff9a72c6683e4c169e0c97014c74525bb2a27b",
    "AUDREY_APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbzkNIe9iFbh0DN4ApI07qv-6vqZlBuhGr_85ED0DpBnhIw1oq7Ubad00jJL4d73Ee36ew/exec"
  }
}
